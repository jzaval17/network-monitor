# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Monitoring Configuration
MONITOR_INTERVAL=60
DEVICE_SCAN_INTERVAL=300
ROUTER_IP=192.168.1.1
GATEWAY_IP=192.168.1.1
INTERNET_CHECK_TIMEOUT=5
INTERNET_CHECK_URLS=https://www.google.com,https://www.cloudflare.com

# Alert Configuration
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=False
ALERT_COOLDOWN=300
# Quiet defaults: group changes, no mentions, suppress push notifications.
DISCORD_SILENT=True
DISCORD_MIN_INTERVAL=300
DISCORD_BATCH_SECONDS=20
DISCORD_CONFIRM_CHECKS=2
DISCORD_RESOURCE_CHECKS=3
DISCORD_RESOURCE_COOLDOWN=1800
DISCORD_DEVICE_ALERTS=True
DISCORD_DEVICE_DISCONNECT_ALERTS=False
DISCORD_MAX_AGE_SECONDS=86400

# System Configuration
LOG_LEVEL=INFO
DATABASE_PATH=network_monitor.db
HOST=0.0.0.0
PORT=5000

# Alerting Thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
